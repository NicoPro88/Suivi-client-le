# Copier dans .env.production (ou .env.local pour tester sur ton PC).
# Ces valeurs viennent de la console Firebase > Paramètres du projet > Vos applications > Web.
# Elles ne sont pas secrètes : elles identifient seulement ton projet.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud > API et services > Identifiants > ID client OAuth (application Web)
VITE_GOOGLE_CLIENT_ID=
